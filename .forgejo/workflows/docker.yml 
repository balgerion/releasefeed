name: build

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: docker
    steps:
      - uses: actions/checkout@v4

      - name: build and push
        run: |
          docker build -t git.balgeriada.com/balgerion/releasefeed:latest .
          docker push git.balgeriada.com/balgerion/releasefeed:latest