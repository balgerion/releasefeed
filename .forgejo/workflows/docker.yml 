name: build

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: docker
    steps:
      - uses: actions/checkout@v4

      - name: build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: git.balgeriada.com/balgerion/releasefeed:latest