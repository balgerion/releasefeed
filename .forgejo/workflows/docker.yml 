name: build

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: docker
    steps:
      - uses: actions/checkout@v4

      - name: login
        run: echo "${{ secrets.FORGEJO_TOKEN }}" | docker login git.balgeriada.com -u balgerion --password-stdin

      - name: build and push
        run: |
          docker build -t git.balgeriada.com/balgerion/releasefeed:latest .
          docker push git.balgeriada.com/balgerion/releasefeed:latest